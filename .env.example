# Auto-Rename Configuration File
# Copy this file to .env and configure your settings

# Directory containing files to rename (required unless using -web-only)
# Example: DIR=/path/to/your/files
DIR=

# Preview changes without actually renaming files (true/false)
# DRY_RUN=true

# Port for web interface (default: 8080)
# WEB_PORT=8080

# Only start web server without renaming files (true/false)
# WEB_ONLY=false

# SQLite database path (default: ./file_renames.db)
# DB_PATH=./file_renames.db

# Continuously scan directory (true/false)
# Requires DIR to be specified
# CRON=false

# Cron expression for scan schedule (default: */1 * * * * - every minute)
# Examples:
# */5 * * * * - Every 5 minutes
# */30 * * * * - Every 30 minutes
# 0 * * * * - Every hour
# 0 0 * * * - Daily at midnight
# 0 */6 * * * - Every 6 hours
# 0 9-17 * * 1-5 - Weekdays 9 AM to 5 PM
# CRON_EXPR="*/1 * * * *"

# Allow renaming files in subfolders (true/false)
# RENAME_SUBFOLDER=true
